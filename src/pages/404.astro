---
import Base from '../layouts/Base.astro';
---

<Base titulo="Página no encontrada" noindex>
  <section class="seccion" style="border-top:0">
    <div class="contenedor" style="padding-block:48px 80px">
      <h1>404</h1>
      <p class="texto" style="font-size:1.4rem;font-weight:500">Esta dirección no existe. Vuelve al inicio o busca una vivienda.</p>
      <div style="display:flex;gap:12px;flex-wrap:wrap"><a class="btn" href="/">Ir al inicio</a><a class="btn btn--linea" href="/buscar/">Buscar vivienda</a></div>
    </div>
  </section>
</Base>
