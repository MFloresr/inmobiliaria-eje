---
import { menu, sitio } from '../lib/sitio';
const { direccion: d } = sitio;
---

<footer class="pie">
  <div class="pie__aviso">Web de demostración: las viviendas, los precios y el equipo son de ejemplo. No se puede contratar nada de verdad.</div>
  <div class="contenedor pie__contenido">
    <div class="pie__rejilla">
      <div>
        <a class="logo" href="/" translate="no">eje<span class="solo-lectores"> inmobiliaria, ir al inicio</span></a>
        <p style="margin-top:14px;max-width:32ch">{sitio.eslogan}.</p>
        <p>{d.calle}<br />{d.cp} {d.ciudad} ({d.provincia})</p>
      </div>
      <div>
        <h2>Contacto</h2>
        <ul>
          <li><a href={`tel:${sitio.telefono}`}>{sitio.telefonoVisible}</a></li>
          <li><a href={`mailto:${sitio.email}`}>{sitio.email}</a></li>
          <li><a href={`https://wa.me/${sitio.whatsapp}`}>WhatsApp</a></li>
          <li><a href="/contacto/">Cómo llegar</a></li>
        </ul>
      </div>
      <div>
        <h2>Horario</h2>
        <ul>
          {sitio.horarios.map((h) => (
            <li><strong>{h.etiqueta}</strong><br />{h.tramos.length ? h.tramos.map((t) => `${t.abre} a ${t.cierra}`).join(' y ') : 'Cerrado'}</li>
          ))}
        </ul>
      </div>
      <div>
        <h2>Navegar</h2>
        <ul>
          {menu.map((m) => <li><a href={m.href}>{m.texto}</a></li>)}
          <li><a href="/favoritos/">Favoritos</a></li>
          <li><a href="/contacto/">Contacto</a></li>
        </ul>
      </div>
    </div>
    <div class="pie__bajo">
      <span>© {new Date().getFullYear()} {sitio.nombre}</span>
      <span>
        <a href="/aviso-legal/">Aviso legal</a> · <a href="/condiciones-de-reserva/">Condiciones de visita</a> · <a href="/privacidad/">Privacidad</a> · <a href="/cookies/">Cookies</a> · <a href="/creditos/">Créditos</a>
      </span>
    </div>
  </div>
</footer>

<script>
  // Contador de favoritos en la cabecera (se guarda solo en este navegador)
  function leer(): string[] { try { return JSON.parse(localStorage.getItem('eje:favoritos') || '[]'); } catch { return []; } }
  const n = document.getElementById('fav-n');
  const pintar = () => { if (n) n.textContent = String(leer().length); };
  const marcar = () => {
    const f = leer();
    document.querySelectorAll<HTMLButtonElement>('[data-fav]').forEach((b) => b.setAttribute('aria-pressed', String(f.includes(b.dataset.fav!))));
  };
  pintar(); marcar();
  document.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-fav]');
    if (!b) return;
    e.preventDefault();
    const f = leer(); const id = b.dataset.fav!;
    const nuevo = f.includes(id) ? f.filter((x) => x !== id) : [...f, id];
    try { localStorage.setItem('eje:favoritos', JSON.stringify(nuevo)); } catch { /* sin almacenamiento */ }
    pintar(); marcar();
    window.dispatchEvent(new Event('eje:favoritos'));
  });
  window.addEventListener('storage', () => { pintar(); marcar(); });
</script>
